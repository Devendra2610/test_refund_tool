# Version control ignores

# Python / Backend
backend/venv/
backend/.venv/
backend/__pycache__/
backend/*/__pycache__/
backend/*/*/__pycache__/
*.py[cod]
*$py.class
backend/data/*.db
backend/data/uploads/*
!backend/data/uploads/.gitkeep
backend/data/output/*
!backend/data/output/.gitkeep

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/.env.local
frontend/.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS / IDE
.DS_Store
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
